# --- Server ---
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# --- Database ---
DATABASE_URL="postgresql://postgres:sanju2506@localhost:5432/resume_analyzer?schema=public"

# --- Auth ---
JWT_SECRET=replace-with-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=7d

# --- AI (keys live ONLY on the server) ---
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# --- Uploads ---
MAX_FILE_SIZE_MB=5

# Number of reverse proxies in front of the API (0 locally, usually 1 on a hosting platform)
TRUST_PROXY=0

# Let the API also serve the built website (one-service deployment)
SERVE_CLIENT=false
